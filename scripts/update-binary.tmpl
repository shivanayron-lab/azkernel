#!/sbin/sh
# @ROM_NAME@ installer for @DEVICE_TITLE@ (generated by azkernel mkzip.py).
# Checks device and partitions first, verifies the package, writes and verifies each
# partition. Recovery and data are left alone.
OUTFD="$2"
ZIPFILE="$3"
BB=/sbin/busybox
[ -x "$BB" ] || BB=/system/bin/busybox

ui_print() { echo "ui_print $*" >&$OUTFD; echo "ui_print" >&$OUTFD; }
set_progress() { echo "set_progress $1" >&$OUTFD; }
abort() { ui_print " "; ui_print "! $*"; ui_print "! Nada foi gravado."; exit 1; }
fail() { ui_print " "; ui_print "! $*"; ui_print "! Nao reinicie: restaure o backup ou instale de novo."; exit 1; }
sha() { "$BB" sha256sum | "$BB" cut -d' ' -f1; }

# check_part <by-name> <dev> <size>: the real gate, the layout must match exactly.
check_part() {
    link=""
    for d in /dev/block/platform/*/by-name /dev/block/platform/*/*/by-name /dev/block/by-name; do
        [ -e "$d/$1" ] && link="$("$BB" readlink -f "$d/$1")"
    done
    [ "$link" = "$2" ] || abort "Layout de particoes inesperado ($1=${link:-?}, esperado $2)"
    [ "$("$BB" blockdev --getsize64 "$2")" = "$3" ] || abort "Tamanho inesperado de $1"
}
check_entry() {
    [ "$("$BB" unzip -p "$ZIPFILE" "$1" | sha)" = "$2" ] || abort "Pacote danificado ($1), baixe de novo"
}
# flash_part <name> <dev> <entry> <gzip 0|1> <image bytes> <image sha256>
write_part() {
    if [ "$4" = 1 ]; then "$BB" unzip -p "$ZIPFILE" "$3" | "$BB" gzip -dc > "$2"
    else "$BB" unzip -p "$ZIPFILE" "$3" | "$BB" dd of="$2" bs=1048576 2>/dev/null; fi
    sync
}
flash_part() {
    grep -q " /$(echo "$1" | "$BB" tr 'A-Z' 'a-z') " /proc/mounts && umount "/$(echo "$1" | "$BB" tr 'A-Z' 'a-z')"
    ui_print "- Gravando $1"
    write_part "$@" || fail "Falha ao gravar $1"
    if [ "$("$BB" head -c "$5" "$2" | sha)" != "$6" ]; then
        ui_print "  Conferencia falhou, gravando de novo"
        write_part "$@" || fail "Falha ao gravar $1"
        [ "$("$BB" head -c "$5" "$2" | sha)" = "$6" ] || fail "Conferencia de $1 falhou duas vezes"
    fi
    ui_print "  $1: ok"
}

ui_print " "
ui_print "@ROM_NAME@ | @RELEASE@"
ui_print "@DEVICE_TITLE@"
ui_print " "
set_progress 0

ui_print "- Verificando o aparelho"
MODEL="$(getprop ro.product.model)"
DEVICE="$(getprop ro.product.device)"
case "$MODEL$DEVICE" in
@MODEL_CASE@esac
@PART_CHECKS@ui_print "  ${MODEL:-?} / ${DEVICE:-?}: ok"
set_progress 0.05

ui_print "- Conferindo o pacote"
@PKG_CHECKS@set_progress 0.15

@FLASH@set_progress 1
ui_print "- Pronto"
ui_print " "
@NOTES@exit 0
